<Window x:Class="FxFixGateway.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:vm="clr-namespace:FxFixGateway.UI.ViewModels"
        xmlns:views="clr-namespace:FxFixGateway.UI.Views"
        mc:Ignorable="d"
        Title="Fx Fix Gateway"
        Height="860"
        Width="1440"
        MinHeight="640"
        MinWidth="1100"
        Background="{StaticResource Gw.Brush.Window}"
        TextElement.Foreground="{StaticResource Gw.Brush.Text}"
        FontFamily="Segoe UI"
        WindowStyle="None"
        ResizeMode="CanResize"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Loaded="Window_Loaded">

    <!-- Custom title bar like the Blotter's: borderless but resizable -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="37"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Gw.Brush.Border}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1"/>
                <Style.Triggers>
                    <!-- A borderless maximized window reaches past the screen edge; keep the content inside -->
                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="7"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ──────────── Title bar ──────────── -->
            <Border Grid.Row="0"
                    BorderBrush="{StaticResource Gw.Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Icon + title (the draggable caption area) -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="16,6">
                        <Image x:Name="TitleBarIcon"
                               Width="24"
                               Height="24"
                               Margin="0,0,10,0"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                        <TextBlock Text="FX FIX Gateway"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Gw.Brush.Text}"
                                   VerticalAlignment="Center"
                                   Margin="0,1,0,0"/>
                    </StackPanel>

                    <!-- Window buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                        <Button Style="{StaticResource Gw.WindowButton}" Click="MinimizeButton_Click" ToolTip="Minimize">
                            <Path Data="M0,5 H10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"/>
                        </Button>
                        <Button Style="{StaticResource Gw.WindowButton}" Click="MaximizeButton_Click" ToolTip="Maximize">
                            <Path Data="M0,0 H10 V10 H0 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"
                                  Fill="Transparent"/>
                        </Button>
                        <Button Style="{StaticResource Gw.WindowCloseButton}" Click="CloseButton_Click" ToolTip="Close">
                            <Path Data="M0,0 L10,10 M10,0 L0,10"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1" Margin="16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ──────────── Header ──────────── -->
                <Border Grid.Row="0" Style="{StaticResource Gw.Card}" Padding="16,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Width="40" Height="40"
                                CornerRadius="10"
                                Background="{StaticResource Gw.Brush.Logo}"
                                Margin="0,0,14,0">
                            <materialDesign:PackIcon Kind="SwapHorizontal"
                                                     Width="22" Height="22"
                                                     Foreground="White"
                                                     HorizontalAlignment="Center"
                                                     VerticalAlignment="Center"/>
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="FX FIX Gateway" Style="{StaticResource Gw.Title}"/>
                            <TextBlock Text="FIX sessions · PostMarker · STP into trade_stp" Style="{StaticResource Gw.Muted}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">

                            <!-- FIX sessions logged on -->
                            <Border Style="{StaticResource Gw.Pill}"
                                    Margin="0,0,8,0"
                                    Background="{Binding SessionList.SessionsStateColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.12}"
                                    BorderBrush="{Binding SessionList.SessionsStateColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.35}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Gw.Dot}"
                                             Margin="0,0,6,0"
                                             Fill="{Binding SessionList.SessionsStateColor, Converter={StaticResource HexToBrush}}"/>
                                    <TextBlock Foreground="{Binding SessionList.SessionsStateColor, Converter={StaticResource HexToBrush}}"><Run Text="FIX "/><Run Text="{Binding SessionList.LoggedOnCount, Mode=OneWay}"/><Run Text="/"/><Run Text="{Binding SessionList.Sessions.Count, Mode=OneWay}"/></TextBlock>
                                </StackPanel>
                            </Border>

                            <!-- PostMarker -->
                            <Border Style="{StaticResource Gw.Pill}"
                                    Margin="0,0,8,0"
                                    Background="{Binding PostMarker.StateColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.12}"
                                    BorderBrush="{Binding PostMarker.StateColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.35}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Style="{StaticResource Gw.Dot}"
                                             Margin="0,0,6,0"
                                             Fill="{Binding PostMarker.StateColor, Converter={StaticResource HexToBrush}}"/>
                                    <TextBlock Text="PostMarker"
                                               Foreground="{Binding PostMarker.StateColor, Converter={StaticResource HexToBrush}}"/>
                                </StackPanel>
                            </Border>

                            <!-- Who and where -->
                            <Border Style="{StaticResource Gw.Pill}">
                                <TextBlock Text="{Binding MachineText, Mode=OneWay}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ──────────── Summary cards ──────────── -->
                <Grid Grid.Row="1" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- FIX sessions -->
                    <Border Grid.Column="0" Style="{StaticResource Gw.Card}">
                        <StackPanel>
                            <TextBlock Text="FIX SESSIONS" Style="{StaticResource Gw.Label}"/>
                            <TextBlock Style="{StaticResource Gw.Value}" Margin="0,6,0,2"><Run Text="{Binding SessionList.LoggedOnCount, Mode=OneWay}"/><Run Text=" / " Foreground="{StaticResource Gw.Brush.TextFaint}"/><Run Text="{Binding SessionList.Sessions.Count, Mode=OneWay}" Foreground="{StaticResource Gw.Brush.TextMuted}"/></TextBlock>
                            <TextBlock Style="{StaticResource Gw.Muted}"><Run Text="logged on · "/><Run Text="{Binding SessionList.RunningSessionsCount, Mode=OneWay}"/><Run Text=" running"/></TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- PostMarker -->
                    <Border Grid.Column="2" Style="{StaticResource Gw.Card}">
                        <StackPanel>
                            <TextBlock Text="POSTMARKER" Style="{StaticResource Gw.Label}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,2">
                                <Ellipse Width="10" Height="10"
                                         VerticalAlignment="Center"
                                         Margin="0,2,10,0"
                                         Fill="{Binding PostMarker.StateColor, Converter={StaticResource HexToBrush}}"/>
                                <TextBlock Text="{Binding PostMarker.StateText}"
                                           Style="{StaticResource Gw.Value}"
                                           Foreground="{Binding PostMarker.StateColor, Converter={StaticResource HexToBrush}}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding PostMarker.SummaryText}" Style="{StaticResource Gw.Muted}"/>
                        </StackPanel>
                    </Border>

                    <!-- Gateway -->
                    <Border Grid.Column="4" Style="{StaticResource Gw.Card}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="GATEWAY" Style="{StaticResource Gw.Label}"/>
                                <TextBlock Text="{Binding StartedText, Mode=OneWay}" Style="{StaticResource Gw.Value}" Margin="0,6,0,2"/>
                                <TextBlock Text="{Binding LogFileText}" ToolTip="{Binding LogFilePath}" Style="{StaticResource Gw.Muted}"/>
                            </StackPanel>

                            <Button Grid.Column="1"
                                    Style="{StaticResource Gw.Button}"
                                    Command="{Binding OpenLogFolderCommand}"
                                    VerticalAlignment="Bottom"
                                    Padding="12,6">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Kind="FolderOpenOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                                    <TextBlock Text="Log folder" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ──────────── Connections and details ──────────── -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" MinWidth="280"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*" MinWidth="560"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: FIX sessions and PostMarker -->
                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource Gw.Card}" Padding="0">
                            <views:SessionListView DataContext="{Binding SessionList}"/>
                        </Border>

                        <Button Grid.Row="1"
                                Margin="0,12,0,0"
                                Command="{Binding SelectPostMarkerCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource Gw.CardButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPostMarkerSelected}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource Gw.Brush.CardRaised}"/>
                                            <Setter Property="BorderBrush" Value="{StaticResource Gw.Brush.Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.ColumnSpan="3"
                                           Text="POSTMARKER"
                                           Style="{StaticResource Gw.Label}"
                                           Margin="0,0,0,8"/>

                                <Ellipse Grid.Row="1" Grid.Column="0"
                                         Style="{StaticResource Gw.Dot}"
                                         Margin="0,0,10,0"
                                         Fill="{Binding PostMarker.StateColor, Converter={StaticResource HexToBrush}}"/>

                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="FXO Hub"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           VerticalAlignment="Center"/>

                                <Border Grid.Row="1" Grid.Column="2"
                                        Style="{StaticResource Gw.Pill}"
                                        Background="{Binding PostMarker.StateColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.12}"
                                        BorderBrush="{Binding PostMarker.StateColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.35}">
                                    <TextBlock Text="{Binding PostMarker.StateText}"
                                               Foreground="{Binding PostMarker.StateColor, Converter={StaticResource HexToBrush}}"/>
                                </Border>

                                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                           Text="{Binding PostMarker.SummaryText}"
                                           Style="{StaticResource Gw.Faint}"
                                           Margin="0,4,0,0"/>
                            </Grid>
                        </Button>
                    </Grid>

                    <GridSplitter Grid.Column="1"
                                  Width="12"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="Transparent"
                                  ShowsPreview="True"/>

                    <!-- Right: FIX session details, or the PostMarker panel -->
                    <Border Grid.Column="2" Style="{StaticResource Gw.Card}" Padding="0">
                        <Grid>
                            <Grid Visibility="{Binding IsPostMarkerSelected, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                <views:SessionDetailView DataContext="{Binding SessionDetail}"/>
                            </Grid>
                            <Grid Visibility="{Binding IsPostMarkerSelected, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <views:PostMarkerView DataContext="{Binding PostMarker}"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ──────────── Loading overlay ──────────── -->
                <Grid Grid.RowSpan="3"
                      Margin="-16"
                      Background="{StaticResource Gw.Brush.Overlay}"
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <StackPanel HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                        <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                     Value="0"
                                     IsIndeterminate="True"
                                     Width="44"
                                     Height="44"/>
                        <TextBlock Text="Loading sessions…"
                                   Foreground="{StaticResource Gw.Brush.TextMuted}"
                                   FontSize="14"
                                   Margin="0,14,0,0"
                                   HorizontalAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
