<UserControl x:Class="FxFixGateway.UI.Views.MessageLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:FxFixGateway.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MessageLogViewModel}"
             d:DesignHeight="500" d:DesignWidth="700">

    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="170"/>
        </Grid.RowDefinitions>

        <!-- Filter Controls -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBox Grid.Column="0"
                     materialDesign:HintAssist.Hint="Search messages..."
                     materialDesign:HintAssist.IsFloating="False"
                     materialDesign:TextFieldAssist.TextFieldCornerRadius="8"
                     Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                     Padding="10,8"
                     VerticalAlignment="Center"
                     Margin="0,0,8,0"/>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding DirectionOptions}"
                      SelectedItem="{Binding SelectedDirection}"
                      materialDesign:HintAssist.Hint="Direction"
                      materialDesign:TextFieldAssist.TextFieldCornerRadius="8"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Padding="10,8"
                      Width="130"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"/>

            <ComboBox Grid.Column="2"
                      ItemsSource="{Binding MsgTypeOptions}"
                      SelectedValuePath="Code"
                      DisplayMemberPath="Display"
                      SelectedValue="{Binding SelectedMsgType}"
                      materialDesign:HintAssist.Hint="Type"
                      materialDesign:TextFieldAssist.TextFieldCornerRadius="8"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Padding="10,8"
                      Width="240"
                      VerticalAlignment="Center"
                      Margin="0,0,8,0"/>

            <Button Grid.Column="3"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Gw.IconButton}"
                    ToolTip="Refresh"
                    Margin="0,0,8,0">
                <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
            </Button>

            <Button Grid.Column="4"
                    Command="{Binding ClearMessagesCommand}"
                    Style="{StaticResource Gw.IconButton}"
                    ToolTip="Clear">
                <materialDesign:PackIcon Kind="Delete" Width="18" Height="18"/>
            </Button>
        </Grid>

        <!-- Message List -->
        <Border Grid.Row="1" Style="{StaticResource Gw.InnerCard}" Padding="0">
            <DataGrid ItemsSource="{Binding FilteredMessages}"
                      SelectedItem="{Binding SelectedMessage}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Auto"
                      RowStyle="{StaticResource Gw.DataGridRow}">

                <DataGrid.Columns>
                    <!-- Time -->
                    <DataGridTextColumn Header="TIME"
                                        Binding="{Binding TimeFormatted}"
                                        Width="110">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource Gw.Font.Mono}"/>
                                <Setter Property="Foreground" Value="{StaticResource Gw.Brush.TextMuted}"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Direction -->
                    <DataGridTemplateColumn Header="DIRECTION" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,2" Margin="0,1">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Gw.Pill.Blue}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DirectionText}" Value="OUT">
                                                    <Setter Property="Background" Value="{StaticResource Gw.Brush.GreenSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Gw.Brush.GreenLine}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Gw.Brush.Green}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding DirectionText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Type -->
                    <DataGridTextColumn Header="TYPE"
                                        Binding="{Binding MsgType}"
                                        Width="80">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontFamily" Value="{StaticResource Gw.Font.Mono}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Summary -->
                    <DataGridTextColumn Header="SUMMARY"
                                        Binding="{Binding Summary}"
                                        Width="*"
                                        MinWidth="150"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Separator -->
        <GridSplitter Grid.Row="2"
                      Height="10"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ShowsPreview="True"/>

        <!-- Raw Message Panel -->
        <Border Grid.Row="3" Style="{StaticResource Gw.InnerCard}" Padding="12,8,12,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="RAW FIX MESSAGE"
                               Style="{StaticResource Gw.Label}"
                               VerticalAlignment="Center"/>

                    <Button Grid.Column="1"
                            Command="{Binding CopyRawMessageCommand}"
                            Style="{StaticResource Gw.Button}"
                            Padding="10,4"
                            ToolTip="Copy to clipboard">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentCopy"
                                                     Width="14" Height="14"
                                                     VerticalAlignment="Center"/>
                            <TextBlock Text="Copy"
                                       FontSize="12"
                                       Margin="6,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <TextBox Grid.Row="1"
                         Text="{Binding RawMessageText, Mode=OneWay}"
                         Style="{StaticResource Gw.CodeBox}"
                         Background="{StaticResource Gw.Brush.Card}"/>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="4"
              Background="{StaticResource Gw.Brush.Overlay}"
              Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True"
                         Width="40" Height="40"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
