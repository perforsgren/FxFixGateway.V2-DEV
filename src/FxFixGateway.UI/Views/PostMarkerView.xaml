<UserControl x:Class="FxFixGateway.UI.Views.PostMarkerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:FxFixGateway.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PostMarkerViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <Grid Margin="20,18,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ──────────── Header ──────────── -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="PostMarker"
                               Style="{StaticResource Gw.PageTitle}"
                               VerticalAlignment="Center"/>
                    <Border Style="{StaticResource Gw.Pill}"
                            Margin="12,0,0,0"
                            Background="{Binding StateColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.12}"
                            BorderBrush="{Binding StateColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.35}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource Gw.Dot}"
                                     Margin="0,0,6,0"
                                     Fill="{Binding StateColor, Converter={StaticResource HexToBrush}}"/>
                            <TextBlock Text="{Binding StateText}"
                                       Foreground="{Binding StateColor, Converter={StaticResource HexToBrush}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock Text="FXO Hub · BrokerML deals via PostMarker's web service · heartbeat POSTMARKER_PROD"
                           Style="{StaticResource Gw.Muted}"
                           Margin="0,4,0,0"/>
                <TextBlock Text="{Binding StateDetail}"
                           Margin="0,4,0,0"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Gw.Brush.Amber}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StateDetail}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Style="{StaticResource Gw.Button.Primary}"
                        Command="{Binding AcceptCommand}"
                        ToolTip="Send Accept for the selected deal"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckBold" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Accept" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Gw.Button}"
                        Command="{Binding ReconnectCommand}"
                        ToolTip="Drop the PostMarker session and connect again"
                        Margin="0,0,8,0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Restart" Width="16" Height="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Reconnect" Margin="6,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource Gw.IconButton}"
                        Command="{Binding RefreshCommand}"
                        ToolTip="Reload the latest deals from the database">
                    <materialDesign:PackIcon Kind="Refresh" Width="18" Height="18"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ──────────── Statistics ──────────── -->
        <Grid Grid.Row="1" Margin="0,16,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Gw.InnerCard}">
                <StackPanel>
                    <TextBlock Text="RECEIVED" Style="{StaticResource Gw.Label}"/>
                    <TextBlock Text="{Binding ReceivedCount, Mode=OneWay}" Style="{StaticResource Gw.Value}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource Gw.InnerCard}">
                <StackPanel>
                    <TextBlock Text="ACKNOWLEDGED" Style="{StaticResource Gw.Label}"/>
                    <TextBlock Text="{Binding AcknowledgedCount, Mode=OneWay}" Style="{StaticResource Gw.Value}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="4" Style="{StaticResource Gw.InnerCard}">
                <StackPanel>
                    <TextBlock Text="ACCEPTED" Style="{StaticResource Gw.Label}"/>
                    <TextBlock Text="{Binding AcceptedCount, Mode=OneWay}"
                               Style="{StaticResource Gw.Value}"
                               Foreground="{StaticResource Gw.Brush.Green}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="6" Style="{StaticResource Gw.InnerCard}">
                <StackPanel>
                    <TextBlock Text="LAST SEQUENCE" Style="{StaticResource Gw.Label}"/>
                    <TextBlock Text="{Binding LastSequenceText, Mode=OneWay}" Style="{StaticResource Gw.Value}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ──────────── Incoming payloads ──────────── -->
        <Border Grid.Row="2" Style="{StaticResource Gw.InnerCard}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="14,12,14,4">
                    <TextBlock Text="INCOMING PAYLOADS" Style="{StaticResource Gw.Label}" VerticalAlignment="Center"/>
                    <TextBlock Text="latest 100 and everything since start"
                               Style="{StaticResource Gw.Faint}"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <DataGrid Grid.Row="1"
                          ItemsSource="{Binding Payloads}"
                          SelectedItem="{Binding SelectedPayload}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          VerticalScrollBarVisibility="Auto"
                          RowStyle="{StaticResource Gw.DataGridRow}">

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="SEQ" Binding="{Binding SequenceNumber}" Width="80">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource Gw.Font.Mono}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="STATUS" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Padding="8,2" Margin="0,1">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Gw.Pill.Blue}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="ACCEPTED">
                                                        <Setter Property="Background" Value="{StaticResource Gw.Brush.GreenSoft}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource Gw.Brush.GreenLine}"/>
                                                        <Setter Property="TextElement.Foreground" Value="{StaticResource Gw.Brush.Green}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="6" Height="6"
                                                     Margin="0,0,6,0"
                                                     VerticalAlignment="Center"
                                                     Fill="{Binding (TextElement.Foreground), RelativeSource={RelativeSource AncestorType=Border}}"/>
                                            <TextBlock Text="{Binding Status}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="TIME" Binding="{Binding TimeText}" Width="110">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="FontFamily" Value="{StaticResource Gw.Font.Mono}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Gw.Brush.TextMuted}"/>
                                    <Setter Property="VerticalAlignment" Value="Center"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Header="ACK" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="–"/>
                                                <Setter Property="Foreground" Value="{StaticResource Gw.Brush.TextFaint}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Acknowledged}" Value="True">
                                                        <Setter Property="Text" Value="✓"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Gw.Brush.Green}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="ACCEPT" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="Bold" VerticalAlignment="Center">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="–"/>
                                                <Setter Property="Foreground" Value="{StaticResource Gw.Brush.TextFaint}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Accepted}" Value="True">
                                                        <Setter Property="Text" Value="✓"/>
                                                        <Setter Property="Foreground" Value="{StaticResource Gw.Brush.Green}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Loading -->
                <Grid Grid.RowSpan="2"
                      Background="{StaticResource Gw.Brush.Overlay}"
                      Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                                 IsIndeterminate="True"
                                 Width="36" Height="36"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"/>
                </Grid>
            </Grid>
        </Border>

        <GridSplitter Grid.Row="3"
                      Height="10"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ShowsPreview="True"/>

        <!-- ──────────── Payload XML / activity log ──────────── -->
        <TabControl Grid.Row="4">
            <TabItem Header="Payload XML">
                <Grid Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Style="{StaticResource Gw.Faint}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="BrokerML · SeqNo {0}">
                                    <Binding Path="SelectedPayload.SequenceNumber" FallbackValue="–"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>

                        <Button Grid.Column="1"
                                Command="{Binding CopyXmlCommand}"
                                Style="{StaticResource Gw.Button}"
                                Padding="10,4"
                                ToolTip="Copy to clipboard">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentCopy" Width="14" Height="14" VerticalAlignment="Center"/>
                                <TextBlock Text="Copy" FontSize="12" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <TextBox Grid.Row="1"
                             Text="{Binding SelectedXml, Mode=OneWay}"
                             Style="{StaticResource Gw.CodeBox}"/>
                </Grid>
            </TabItem>

            <TabItem Header="Activity log">
                <Border Style="{StaticResource Gw.InnerCard}" Margin="0,10,0,0" Padding="4">
                    <ListBox ItemsSource="{Binding Activity}"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="8,4"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="70"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TimeText}"
                                               FontFamily="{StaticResource Gw.Font.Mono}"
                                               FontSize="11"
                                               Foreground="{StaticResource Gw.Brush.TextFaint}"
                                               VerticalAlignment="Top"
                                               Margin="0,1,0,0"/>
                                    <Ellipse Grid.Column="1"
                                             Width="7" Height="7"
                                             VerticalAlignment="Top"
                                             Margin="0,5,10,0"
                                             Fill="{Binding DotColor, Converter={StaticResource HexToBrush}}"/>
                                    <TextBlock Grid.Column="2"
                                               Text="{Binding Message}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
