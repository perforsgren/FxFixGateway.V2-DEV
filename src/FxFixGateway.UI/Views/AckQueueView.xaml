<UserControl x:Class="FxFixGateway.UI.Views.AckQueueView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:FxFixGateway.UI.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AckQueueViewModel}"
             d:DesignHeight="500" d:DesignWidth="800">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Grid Margin="0,16,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Statistics -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Pending -->
            <Border Grid.Column="0" Style="{StaticResource Gw.InnerCard}">
                <StackPanel>
                    <TextBlock Text="PENDING" Style="{StaticResource Gw.Label}"/>
                    <TextBlock Text="{Binding PendingCount}"
                               Style="{StaticResource Gw.Value}"
                               Foreground="{StaticResource Gw.Brush.Amber}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Sent Today -->
            <Border Grid.Column="2" Style="{StaticResource Gw.InnerCard}">
                <StackPanel>
                    <TextBlock Text="SENT TODAY" Style="{StaticResource Gw.Label}"/>
                    <TextBlock Text="{Binding SentTodayCount}"
                               Style="{StaticResource Gw.Value}"
                               Foreground="{StaticResource Gw.Brush.Green}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Failed -->
            <Border Grid.Column="4" Style="{StaticResource Gw.InnerCard}">
                <StackPanel>
                    <TextBlock Text="FAILED" Style="{StaticResource Gw.Label}"/>
                    <TextBlock Text="{Binding FailedCount}"
                               Style="{StaticResource Gw.Value}"
                               Foreground="{StaticResource Gw.Brush.Red}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Filter and Actions -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Filter -->
            <ComboBox Grid.Column="0"
                      ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter}"
                      materialDesign:HintAssist.Hint="Filter"
                      materialDesign:TextFieldAssist.TextFieldCornerRadius="8"
                      Style="{StaticResource MaterialDesignOutlinedComboBox}"
                      Padding="10,8"
                      Width="140"
                      VerticalAlignment="Center"/>

            <!-- Refresh Button -->
            <Button Grid.Column="2"
                    Command="{Binding RefreshCommand}"
                    Style="{StaticResource Gw.Button}"
                    ToolTip="Refresh"
                    Margin="0,0,8,0">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Refresh" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Refresh" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- Retry Failed Button -->
            <Button Grid.Column="3"
                    Command="{Binding RetryFailedCommand}"
                    Style="{StaticResource Gw.Button}"
                    ToolTip="Retry all failed ACKs">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="Replay" Width="16" Height="16" VerticalAlignment="Center"/>
                    <TextBlock Text="Retry failed" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </Grid>

        <!-- ACK List -->
        <Border Grid.Row="2" Style="{StaticResource Gw.InnerCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Acks}"
                      SelectedItem="{Binding SelectedAck}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      VerticalScrollBarVisibility="Auto">

                <DataGrid.Columns>
                    <!-- Status -->
                    <DataGridTemplateColumn Header="STATUS" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Padding="8,2" Margin="0,1">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource Gw.Pill}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Pending">
                                                    <Setter Property="Background" Value="{StaticResource Gw.Brush.AmberSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Gw.Brush.AmberLine}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Gw.Brush.Amber}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Sent">
                                                    <Setter Property="Background" Value="{StaticResource Gw.Brush.GreenSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Gw.Brush.GreenLine}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Gw.Brush.Green}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Failed">
                                                    <Setter Property="Background" Value="{StaticResource Gw.Brush.RedSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Gw.Brush.RedLine}"/>
                                                    <Setter Property="TextElement.Foreground" Value="{StaticResource Gw.Brush.Red}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusText}" Value="Rejected">
                                                    <Setter Property="Background" Value="{StaticResource Gw.Brush.RedSoft}"/>
                                                    <Setter Property="BorderBrush" Value="{StaticResource Gw.Brush.RedLine}"/>
                                                    <Setter Property="TextElement.Foreground" Value="#FB923C"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusText}"/>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- TradeReportID -->
                    <DataGridTextColumn Header="TRADE REPORT ID"
                                        Binding="{Binding TradeReportId}"
                                        Width="160"/>

                    <!-- InternID -->
                    <DataGridTextColumn Header="INTERN ID"
                                        Binding="{Binding InternTradeId}"
                                        Width="130"/>

                    <!-- Created -->
                    <DataGridTextColumn Header="CREATED"
                                        Binding="{Binding CreatedFormatted}"
                                        Width="100"/>

                    <!-- Sent -->
                    <DataGridTextColumn Header="SENT"
                                        Binding="{Binding SentFormatted}"
                                        Width="*"/>
                </DataGrid.Columns>

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource Gw.DataGridRow}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusText}" Value="Pending">
                                <Setter Property="Background" Value="#0AF59E0B"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding StatusText}" Value="Failed">
                                <Setter Property="Background" Value="#0FEF4444"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
            </DataGrid>
        </Border>

        <!-- Separator -->
        <GridSplitter Grid.Row="3"
                      Height="10"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      ShowsPreview="True"/>

        <!-- ACK Details Panel -->
        <Border Grid.Row="4" Style="{StaticResource Gw.InnerCard}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Details -->
                <StackPanel Grid.Column="0">
                    <TextBlock Text="ACK DETAILS"
                               Style="{StaticResource Gw.Label}"
                               Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Trade report ID" Style="{StaticResource Gw.FieldLabel}" Margin="0,3"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedAck.TradeReportId}" FontWeight="SemiBold" Margin="0,3"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Intern trade ID" Style="{StaticResource Gw.FieldLabel}" Margin="0,3"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedAck.InternTradeId}" FontWeight="SemiBold" Margin="0,3"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Created" Style="{StaticResource Gw.FieldLabel}" Margin="0,3"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedAck.CreatedUtc, StringFormat='yyyy-MM-dd HH:mm:ss'}" Margin="0,3"/>

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Status" Style="{StaticResource Gw.FieldLabel}" Margin="0,3"/>
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,3">
                            <Run Text="{Binding SelectedAck.StatusText, Mode=OneWay}"/>
                            <Run Text="{Binding SelectedAck.WaitingTime, Mode=OneWay}" Foreground="{StaticResource Gw.Brush.TextFaint}"/>
                        </TextBlock>
                    </Grid>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom">
                    <Button Command="{Binding SendNowCommand}"
                            Style="{StaticResource Gw.Button}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckBold" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Send now" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Command="{Binding CancelAckCommand}"
                            Style="{StaticResource Gw.Button}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Cancel ACK" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Loading Overlay -->
        <Grid Grid.RowSpan="5"
              Background="{StaticResource Gw.Brush.Overlay}"
              Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <ProgressBar Style="{StaticResource MaterialDesignCircularProgressBar}"
                         IsIndeterminate="True"
                         Width="40" Height="40"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"/>
        </Grid>
    </Grid>
</UserControl>
