<UserControl x:Class="FxFixGateway.UI.Views.SessionListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:FxFixGateway.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="360"
             d:DataContext="{d:DesignInstance Type=vm:SessionListViewModel}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header: title, count, "Show only enabled" switch and add button -->
        <Grid Grid.Row="0" Margin="16,14,12,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="FIX sessions"
                       Style="{StaticResource Gw.Title}"
                       VerticalAlignment="Center"/>

            <Border Grid.Column="1"
                    Style="{StaticResource Gw.Pill}"
                    Margin="8,0,0,0"
                    Padding="7,1">
                <TextBlock Text="{Binding Sessions.Count}"/>
            </Border>

            <TextBlock Grid.Column="3"
                       Text="Show only enabled"
                       Style="{StaticResource Gw.Faint}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>

            <ToggleButton Grid.Column="4"
                          IsChecked="{Binding ShowOnlyEnabled}"
                          Style="{StaticResource Gw.Switch}"
                          ToolTip="Show only enabled sessions"
                          Margin="0,0,10,0"/>
        </Grid>

        <!-- Session list -->
        <ListBox Grid.Row="1"
                 ItemsSource="{Binding Sessions}"
                 SelectedItem="{Binding SelectedSession}"
                 ItemContainerStyle="{StaticResource Gw.ListRow}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="8,0,8,8"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">

            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Status dot -->
                        <Ellipse Grid.Row="0" Grid.Column="0"
                                 Style="{StaticResource Gw.Dot}"
                                 Margin="0,0,10,0"
                                 Fill="{Binding StatusColor, Converter={StaticResource HexToBrush}}"/>

                        <!-- Session key -->
                        <TextBlock Grid.Row="0" Grid.Column="1"
                                   Text="{Binding SessionKey}"
                                   FontWeight="SemiBold"
                                   FontSize="13"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"/>

                        <!-- Status pill -->
                        <Border Grid.Row="0" Grid.Column="2"
                                Style="{StaticResource Gw.Pill}"
                                Margin="8,0,0,0"
                                Background="{Binding StatusColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.12}"
                                BorderBrush="{Binding StatusColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.35}">
                            <TextBlock Text="{Binding StatusText}"
                                       Foreground="{Binding StatusColor, Converter={StaticResource HexToBrush}}"/>
                        </Border>

                        <!-- Description -->
                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                                   Text="{Binding Description}"
                                   Style="{StaticResource Gw.Muted}"
                                   Margin="0,3,0,0"/>

                        <!-- Last heartbeat, or the last error when there is one -->
                        <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                                   FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   Margin="0,3,0,0">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding LastError}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Gw.Brush.Red}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LastError}" Value="None">
                                            <Setter Property="Text" Value="{Binding LastHeartbeat, StringFormat='Last heartbeat {0}'}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Gw.Brush.TextFaint}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
