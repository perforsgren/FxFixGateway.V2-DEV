<UserControl x:Class="FxFixGateway.UI.Views.SessionDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:vm="clr-namespace:FxFixGateway.UI.ViewModels"
             xmlns:views="clr-namespace:FxFixGateway.UI.Views"
             xmlns:converters="clr-namespace:FxFixGateway.UI.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SessionDetailViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">

    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Editable field (Host, Port): outlined, compact, no floating label -->
        <Style x:Key="EditBox" TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
            <Setter Property="materialDesign:HintAssist.IsFloating" Value="False"/>
            <Setter Property="materialDesign:TextFieldAssist.TextFieldCornerRadius" Value="8"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <!-- Hidden while no session is selected -->
        <Style x:Key="WhenSessionSelected" TargetType="Grid">
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSession}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Shown only while no session is selected -->
        <Style x:Key="WhenNoSessionSelected" TargetType="StackPanel">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding SelectedSession}" Value="{x:Null}">
                    <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Empty state -->
        <StackPanel Style="{StaticResource WhenNoSessionSelected}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
            <materialDesign:PackIcon Kind="LanConnect"
                                     Width="40" Height="40"
                                     HorizontalAlignment="Center"
                                     Foreground="{StaticResource Gw.Brush.TextFaint}"/>
            <TextBlock Text="Select a FIX session or PostMarker"
                       Style="{StaticResource Gw.Title}"
                       HorizontalAlignment="Center"
                       Margin="0,12,0,4"/>
            <TextBlock Text="Details, messages and ACKs are shown here."
                       Style="{StaticResource Gw.Muted}"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid Style="{StaticResource WhenSessionSelected}" Margin="20,18,20,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ──────────── Header ──────────── -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding SelectedSession.SessionKey}"
                                   Style="{StaticResource Gw.PageTitle}"
                                   VerticalAlignment="Center"/>
                        <Border Style="{StaticResource Gw.Pill}"
                                Margin="12,0,0,0"
                                Background="{Binding SelectedSession.StatusColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.12}"
                                BorderBrush="{Binding SelectedSession.StatusColor, Converter={StaticResource HexToBrush}, ConverterParameter=0.35}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Style="{StaticResource Gw.Dot}"
                                         Margin="0,0,6,0"
                                         Fill="{Binding SelectedSession.StatusColor, Converter={StaticResource HexToBrush}}"/>
                                <TextBlock Text="{Binding SelectedSession.StatusText}"
                                           Foreground="{Binding SelectedSession.StatusColor, Converter={StaticResource HexToBrush}}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource Gw.Pill.Amber}"
                                Margin="8,0,0,0"
                                Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="Editing — Host, Port and Enabled"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Gw.Muted}" Margin="0,4,0,0"><Run Text="{Binding SelectedSession.Description, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding SelectedSession.SenderCompID, Mode=OneWay}"/><Run Text=" → "/><Run Text="{Binding SelectedSession.TargetCompID, Mode=OneWay}"/></TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">

                    <!-- Session control -->
                    <Button Style="{StaticResource Gw.Button.Success}"
                            Command="{Binding StartCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Play" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Start" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Gw.Button.Danger}"
                            Command="{Binding StopCommand}"
                            Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Stop" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Stop" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Gw.Button.Warning}"
                            Command="{Binding RestartCommand}"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Restart" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Restart" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- View mode -->
                    <Button Style="{StaticResource Gw.Button}"
                            Command="{Binding EditCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PencilOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Edit" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Gw.Button}"
                            Foreground="{StaticResource Gw.Brush.Red}"
                            Command="{Binding DeleteCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource InverseBoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="TrashCanOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Delete" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Edit mode -->
                    <Button Style="{StaticResource Gw.Button.Primary}"
                            Command="{Binding SaveCommand}"
                            Margin="0,0,8,0"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Save" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Gw.Button}"
                            Command="{Binding CancelEditCommand}"
                            Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Close" Width="16" Height="16" VerticalAlignment="Center"/>
                            <TextBlock Text="Cancel" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ──────────── Overview ──────────── -->
            <Grid Grid.Row="1" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Gw.InnerCard}">
                    <StackPanel>
                        <TextBlock Text="STATUS" Style="{StaticResource Gw.Label}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <Ellipse Style="{StaticResource Gw.Dot}"
                                     Margin="0,0,8,0"
                                     Fill="{Binding SelectedSession.StatusColor, Converter={StaticResource HexToBrush}}"/>
                            <TextBlock Text="{Binding SelectedSession.StatusText}"
                                       FontSize="14"
                                       FontWeight="SemiBold"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Gw.InnerCard}">
                    <StackPanel>
                        <TextBlock Text="LAST HEARTBEAT" Style="{StaticResource Gw.Label}"/>
                        <TextBlock Text="{Binding SelectedSession.LastHeartbeatFormatted}" Style="{StaticResource Gw.SmallValue}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="4" Style="{StaticResource Gw.InnerCard}">
                    <StackPanel>
                        <TextBlock Text="LAST LOGON" Style="{StaticResource Gw.Label}"/>
                        <TextBlock Text="{Binding SelectedSession.LastLogonFormatted}" Style="{StaticResource Gw.SmallValue}"/>
                    </StackPanel>
                </Border>

                <Border Grid.Column="6" Style="{StaticResource Gw.InnerCard}">
                    <StackPanel>
                        <TextBlock Text="LAST LOGOUT" Style="{StaticResource Gw.Label}"/>
                        <TextBlock Text="{Binding SelectedSession.LastLogoutFormatted}" Style="{StaticResource Gw.SmallValue}"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Last error, only when there is one -->
            <Border Grid.Row="2" Margin="0,10,0,0" Padding="14,10" CornerRadius="10" BorderThickness="1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Gw.Brush.RedSoft}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Gw.Brush.RedLine}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding SelectedSession.LastError}" Value="None">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="LAST ERROR" Style="{StaticResource Gw.Label}" Foreground="{StaticResource Gw.Brush.Red}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SelectedSession.LastError}"
                               Foreground="{StaticResource Gw.Brush.Red}"
                               TextWrapping="Wrap"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <!-- ──────────── Tabs ──────────── -->
            <TabControl Grid.Row="3" Margin="0,12,0,0"
                        materialDesign:ColorZoneAssist.Mode="Custom"
                        materialDesign:ColorZoneAssist.Background="Transparent"
                        materialDesign:ColorZoneAssist.Foreground="{StaticResource Gw.Brush.Text}">

                <!-- Details -->
                <TabItem Header="Details">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Connection -->
                            <Border Grid.Column="0" Style="{StaticResource Gw.InnerCard}" Padding="16,12" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="CONNECTION" Style="{StaticResource Gw.Label}" Margin="0,0,0,8"/>

                                    <!-- Session Key (readonly) -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Session key" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding SelectedSession.SessionKey, Mode=OneWay}"
                                             Style="{StaticResource Gw.ValueBox}"
                                             Margin="0,8"/>

                                    <!-- Host (editable) -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Host" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding SelectedSession.Host, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEditMode}"
                                             Style="{StaticResource EditBox}"
                                             Margin="0,4"/>

                                    <!-- Port (editable) -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="Port" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Text="{Binding SelectedSession.Port, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                             IsEnabled="{Binding IsEditMode}"
                                             Style="{StaticResource EditBox}"
                                             Margin="0,4"/>

                                    <!-- SenderCompID (readonly) -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Sender comp ID" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding SelectedSession.SenderCompID, Mode=OneWay}"
                                             Style="{StaticResource Gw.ValueBox}"
                                             Margin="0,8"/>

                                    <!-- TargetCompID (readonly) -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Target comp ID" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1"
                                             Text="{Binding SelectedSession.TargetCompID, Mode=OneWay}"
                                             Style="{StaticResource Gw.ValueBox}"
                                             Margin="0,8"/>

                                    <!-- BeginString (readonly) -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="FIX version" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="6" Grid.Column="1"
                                             Text="{Binding SelectedSession.BeginString, Mode=OneWay}"
                                             Style="{StaticResource Gw.ValueBox}"
                                             Margin="0,8"/>

                                    <!-- IsEnabled (editable) -->
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Enabled" Style="{StaticResource Gw.FieldLabel}"/>
                                    <ToggleButton Grid.Row="7" Grid.Column="1"
                                                  IsChecked="{Binding SelectedSession.IsEnabled, Mode=TwoWay}"
                                                  IsEnabled="{Binding IsEditMode}"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,8"/>
                                </Grid>
                            </Border>

                            <!-- Session timing -->
                            <Border Grid.Column="2" Style="{StaticResource Gw.InnerCard}" Padding="16,12" VerticalAlignment="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="140"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Text="SESSION" Style="{StaticResource Gw.Label}" Margin="0,0,0,8"/>

                                    <!-- HeartbeatInterval (readonly) -->
                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Heartbeat (sec)" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="1" Grid.Column="1"
                                             Text="{Binding SelectedSession.HeartbeatInterval, Mode=OneWay}"
                                             Style="{StaticResource Gw.ValueBox}"
                                             Margin="0,8"/>

                                    <!-- StartTime (readonly) -->
                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Start time" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="2" Grid.Column="1"
                                             Text="{Binding SelectedSession.StartTimeFormatted, Mode=OneWay}"
                                             Style="{StaticResource Gw.ValueBox}"
                                             Margin="0,8"/>

                                    <!-- EndTime (readonly) -->
                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="End time" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="3" Grid.Column="1"
                                             Text="{Binding SelectedSession.EndTimeFormatted, Mode=OneWay}"
                                             Style="{StaticResource Gw.ValueBox}"
                                             Margin="0,8"/>

                                    <!-- ReconnectInterval (readonly) -->
                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="Reconnect (sec)" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="4" Grid.Column="1"
                                             Text="{Binding SelectedSession.ReconnectInterval, Mode=OneWay}"
                                             Style="{StaticResource Gw.ValueBox}"
                                             Margin="0,8"/>

                                    <!-- LogonTimeout (readonly) -->
                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="Logon timeout (sec)" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="5" Grid.Column="1"
                                             Text="{Binding SelectedSession.LogonTimeout, Mode=OneWay}"
                                             Style="{StaticResource Gw.ValueBox}"
                                             Margin="0,8"/>

                                    <!-- LogoutTimeout (readonly) -->
                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="Logout timeout (sec)" Style="{StaticResource Gw.FieldLabel}"/>
                                    <TextBox Grid.Row="6" Grid.Column="1"
                                             Text="{Binding SelectedSession.LogoutTimeout, Mode=OneWay}"
                                             Style="{StaticResource Gw.ValueBox}"
                                             Margin="0,8"/>

                                    <!-- ResetOnLogon (readonly for now) -->
                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="Reset on logon" Style="{StaticResource Gw.FieldLabel}"/>
                                    <ToggleButton Grid.Row="7" Grid.Column="1"
                                                  IsChecked="{Binding SelectedSession.ResetOnLogon, Mode=OneWay}"
                                                  IsEnabled="False"
                                                  Style="{StaticResource MaterialDesignSwitchToggleButton}"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,8"/>
                                </Grid>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <!-- Messages -->
                <TabItem Header="Messages">
                    <views:MessageLogView DataContext="{Binding MessageLog}"/>
                </TabItem>

                <!-- ACKs -->
                <TabItem Header="ACKs">
                    <views:AckQueueView DataContext="{Binding AckQueue}"/>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
