<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="appsettings.json" />
    <None Remove="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="MaterialDesignColors" Version="5.3.0" />
    <PackageReference Include="MaterialDesignThemes" Version="5.3.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.2" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FxFixGateway.Application\FxFixGateway.Application.csproj" />
    <ProjectReference Include="..\FxFixGateway.Domain\FxFixGateway.Domain.csproj" />
    <ProjectReference Include="..\FxFixGateway.Infrastructure\FxFixGateway.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Behaviors\" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FxSharedConfig">
      <HintPath>..\..\..\FxSharedConfig\bin\Debug\FxSharedConfig.dll</HintPath>
    </Reference>
    <Reference Include="FxTradeHub.Data.MySql">
      <HintPath>..\..\..\OptionSuite.V2\libs\FxTradeHub\FxTradeHub.Data.MySql\bin\Debug\netstandard2.0\FxTradeHub.Data.MySql.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="FxTradeHub.Domain">
      <HintPath>..\..\..\OptionSuite.V2\libs\FxTradeHub\FxTradeHub.Domain\bin\Debug\netstandard2.0\FxTradeHub.Domain.dll</HintPath>
      <Private>True</Private>
    </Reference>
    <Reference Include="FxTradeHub.Services">
      <HintPath>..\..\..\OptionSuite.V2\libs\FxTradeHub\FxTradeHub.Services\bin\Debug\netstandard2.0\FxTradeHub.Services.dll</HintPath>
      <Private>True</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="App.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="FIX44_Fenics.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="FIX44_Volbroker.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
